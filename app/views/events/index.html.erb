<% provide(:title, "All Events") %>

<div class="container page-wrap">
  <div class="row">
    <!-- Sidebar filters -->
    <div class="col-md-3" id="search-sidebar">
      <%= form_tag events_path, method: :get do %>
        <div class="sidebar-card">
          <h4>Search</h4>

          <div class="form-group">
            <%= label_tag :search, "Name or description" %>
            <%= text_field_tag :search, params[:search], placeholder: "Party, concert, soccer…", class: "form-control" %>
          </div>

          <div class="form-group">
            <%= label_tag :location, "Location" %>
            <%= text_field_tag :location, params[:location], placeholder: "City, ZIP, address", class: "form-control" %>
          </div>

          <div class="form-group">
            <%= label_tag :category, "Category" %>
            <%= select_tag :category, options_for_select([
                  ["All categories", "0"], ["Arts", "1"], ["Business", "2"], ["Charity", "3"],
                  ["Education", "4"], ["Fashion", "5"], ["Film & Media", "6"], ["Food & Drink", "7"],
                  ["Health", "8"], ["Hobbies", "9"], ["Holiday", "10"], ["Music", "11"],
                  ["Science & Tech", "12"], ["Spirituality", "13"], ["Sports & Fitness", "14"],
                  ["Travel & Outdoor", "15"], ["Other", "16"]
                ], params[:category]), class: "form-control" %>
          </div>

          <%= submit_tag "Search", name: nil, class: "btn btn-primary btn-block" %>
        </div>

        <div class="sidebar-card">
          <h4>Timeline</h4>
          <div class="list-group">
            <%= submit_tag "Upcoming Events", name: "timeline", id: "timeline-upcoming",
                  class: "list-group-item #{'active' if params[:timeline] != 'Past Events'}" %>
            <%= submit_tag "Past Events", name: "timeline", id: "timeline-past",
                  class: "list-group-item #{'active' if params[:timeline] == 'Past Events'}" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Main content -->
    <div class="col-md-9">
      <div class="row">
        <div class="col-md-12">
          <h2 class="page-title" id="events">
            <%= params[:timeline] == "Past Events" ? "Past Events" : "Upcoming Events" %>
          </h2>
          <p class="page-subtitle"><%= page_entries_info @events %></p>
        </div>
      </div>

      <% if @events.any? %>
        <div class="row">
          <%= render @events %>
        </div>
        <div class="row text-center mt-md">
          <%= paginate @events %>
        </div>
      <% else %>
        <div class="card text-center">
          <p class="text-muted mb-md">No events match your search.</p>
          <p class="text-muted">Try widening your filters or <%= link_to "browse all events", events_path %>.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
