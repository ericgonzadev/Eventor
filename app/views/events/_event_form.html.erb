<% content_for :head do %>
  <%= javascript_include_tag 'google-places.js' %>
<% end %>

<div class="row">
  <div class="col-lg-8 col-lg-offset-2">
    <div class="card">
      <%= form_for(@event, url: url, html: { multipart: true }) do |f| %>
        <%= render "shared/error_messages", object: f.object %>

        <div class="form-group">
          <%= f.label :title, "Event title" %><span id="required">*</span>
          <%= f.text_field :title, class: "form-control", placeholder: "What's it called?" %>
        </div>

        <div class="form-group">
          <%= f.label :description, "Description" %><span id="required">*</span>
          <%= f.text_area :description, rows: 8, class: "form-control", placeholder: "Tell people what to expect" %>
        </div>

        <div class="form-group">
          <%= f.label :address, "Address / location" %><span id="required">*</span>
          <%= f.text_field :address, class: "form-control", id: "txtautocomplete", placeholder: "Start typing an address…" %>
        </div>

        <div class="row">
          <div class="col-sm-6">
            <div class="form-group">
              <%= label_tag :category_id, "Category" %><span id="required">*</span>
              <%= select_tag :category_id, options_for_select(Category.all.map { |c| [c.name, c.id] }, @event.category_id), class: "form-control" %>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="form-group">
              <%= f.label :date, "Date & time" %><span id="required">*</span><br>
              <%= f.datetime_select :date, { ampm: true, minute_step: 15, start_year: Date.today.year, end_year: Date.today.year + 5, order: [:month, :day, :year], default: Time.current } %>
            </div>
          </div>
        </div>

        <div class="form-group">
          <% if @event.picture? %>
            <label>Current image</label><br>
            <%= image_tag @event.picture.url, class: "img-responsive mb-md", style: "max-height: 220px; border-radius: 10px;", alt: "current event image" %>
            <%= f.label :picture, "Replace image (under 5MB)" %>
          <% else %>
            <%= f.label :picture, "Event image (optional, under 5MB)" %>
          <% end %>
          <%= f.file_field :picture, accept: 'image/jpeg,image/gif,image/png', class: "form-control" %>
        </div>

        <div class="text-center mt-lg">
          <%= f.submit button, class: "btn btn-primary btn-xl" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
