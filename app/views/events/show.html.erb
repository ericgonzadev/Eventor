<% provide(:title, @event.title) %>

<div class="container page-wrap">
  <div class="row">
    <div class="col-lg-8">
      <!-- Event header -->
      <% if @event.picture? %>
        <%= image_tag @event.picture.url, class: "img-responsive", id: "event-show-image", alt: @event.title %>
      <% else %>
        <%= image_tag "event-show-default.jpg", class: "img-responsive", id: "event-show-image", alt: "default event image" %>
      <% end %>

      <span class="pill pill-category mb-md"><%= @category %></span>
      <h1 class="page-title wrap"><%= @event.title %></h1>

      <p class="text-muted">
        Created by <%= link_to @event.user.name, @event.user %> ·
        <i class="fa fa-calendar"></i> <%= @event.date.strftime("%A, %B %d %Y") %> ·
        <i class="fa fa-clock-o"></i> <%= @event.date.strftime("%-I:%M %p") %>
      </p>

      <hr class="soft">

      <p class="lead wrap"><%= @event.description %></p>

      <!-- Owner / attendance actions -->
      <% if current_user %>
        <% if current_user.id == @event.user_id %>
          <p class="mt-lg">
            <%= link_to "Edit Event", edit_event_path(@event), class: "btn btn-primary", id: "show-edit-button" %>
            <%= link_to "Delete Event", @event, method: :delete, data: { confirm: "You sure?" }, class: "btn btn-default" %>
          </p>
        <% elsif @event.date > Time.current %>
          <div id="attend_form" class="mt-lg">
            <% if current_user.attending?(@event) %>
              <%= render "unattend" %>
            <% else %>
              <%= render "attend" %>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted mt-lg"><em>This event has ended.</em></p>
        <% end %>
      <% else %>
        <div class="card-soft text-center mt-lg" style="padding: 18px;">
          <p class="text-muted mb-0">
            <%= link_to "Log in", login_path %> or <%= link_to "sign up", signup_path %> to attend or comment on this event.
          </p>
        </div>
      <% end %>

      <hr class="soft">

      <!-- Attendees -->
      <h3 class="page-title" id="attendees-section">
        <% if @event.date > Time.current %>
          Attending <span class="text-muted">(<span id="attendees"><%= @event.attendees.count %></span>)</span>
        <% else %>
          Attended <span class="text-muted">(<span id="attendees"><%= @event.attendees.count %></span>)</span>
        <% end %>
      </h3>

      <% if @event.attendees.any? %>
        <div id="users_attending" class="mb-lg">
          <% @event.attendees.each do |user| %>
            <%= link_to user, class: "pill pill-accent", style: "margin: 0 8px 8px 0; text-decoration: none;" do %>
              <%= user.name %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted">No attendees yet. Be the first!</p>
      <% end %>

      <hr class="soft">

      <!-- Comments -->
      <h3 class="page-title" id="comment_count">
        Comments <span class="text-muted">(<%= @event.comments.count %>)</span>
      </h3>

      <div class="comment_list">
        <%= render @comments %>
      </div>

      <% if current_user %>
        <div class="card-soft mt-lg" style="padding: 20px;">
          <h4 style="margin-top: 0;">Leave a comment</h4>
          <%= render 'comments/form' %>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="col-md-4">
      <div id="event-sidebar" class="sidebar-card">
        <p class="lead"><b>Location</b><%= @event.address %></p>
        <div id="map"></div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
  handler = Gmaps.build('Google');
  handler.buildMap({ provider: {}, internal: {id: 'map'}}, function(){
    markers = handler.addMarkers(<%=raw @hash.to_json %>);
    handler.bounds.extendWith(markers);
    handler.fitMapToBounds();
    handler.getMap().setZoom(15);
  });
</script>
