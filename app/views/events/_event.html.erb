<div class="col-sm-6 col-md-4">
  <%= link_to event_path(event), class: "card-event" do %>
    <% if event.picture? %>
      <%= image_tag event.picture.thumb.url, class: "card-event__image", alt: event.title %>
    <% else %>
      <%= image_tag "event-index-default.jpg", class: "card-event__image", alt: "default event image" %>
    <% end %>

    <div class="card-event__body">
      <h4 class="card-event__title"><%= truncate event.title, length: 60 %></h4>

      <p class="card-event__meta">
        <span class="card-event__creator">Created by <strong><%= event.user.name %></strong></span>
        <span class="card-event__location"><%= truncate event.address, length: 42 %></span>
        <%= event.date.strftime("%a, %b %d %Y · %-I:%M %p") %>
      </p>
    </div>

    <div class="card-event__footer">
      <span class="pill pill-category"><%= Category.find(event.category_id).name %></span>
      <% if event.date > Time.current %>
        <span class="pill pill-attending"><i class="fa fa-users"></i> <%= event.attendees.count %> going</span>
      <% else %>
        <span class="pill pill-attended"><%= event.attendees.count %> attended</span>
      <% end %>
    </div>
  <% end %>
</div>
