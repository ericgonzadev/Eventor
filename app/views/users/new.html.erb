<% provide(:title, "Sign Up") %>

<div class="container page-wrap">
  <div class="row">
    <div class="col-md-5 col-md-offset-3 col-sm-8 col-sm-offset-2">
      <div class="text-center mb-lg">
        <h2 class="page-title">Welcome to Eventor</h2>
        <p class="page-subtitle">Create an account to start discovering and creating events.</p>
      </div>

      <div class="card">
        <%= render "user_form", url: signup_path, button_text: "Sign Up" %>
      </div>

      <p class="text-center mt-lg text-muted">
        Already have an account? <%= link_to "Log in", login_path %>
      </p>
    </div>
  </div>
</div>
