<%= form_for [@event, @comment], remote: true do |f| %>
  <%= f.hidden_field :user_id, value: current_user.id %>
  <div class="form-group">
    <%= f.text_area :body, class: "form-control comment_text", rows: 3, required: true, placeholder: "Share your thoughts…" %>
  </div>
  <div class="text-right">
    <%= f.submit "Post Comment", class: "btn btn-primary", id: "comment-button" %>
  </div>
<% end %>
