<% author = User.find(comment.user_id) %>
<div class="comment-item" id="comment_<%= comment.id %>">
  <%= link_to author, class: "avatar-initial" do %>
    <%= author.name.to_s.split.first(2).map { |w| w[0] }.join.upcase %>
  <% end %>
  <div class="comment-item__body">
    <div class="comment-item__heading">
      <%= link_to author.name, author, class: "comment-item__author" %>
      <span class="comment-item__time"><%= time_ago_in_words(comment.created_at) %> ago</span>
      <% if current_user && current_user == comment.user %>
        <%= link_to "Delete", comment, method: :delete, remote: true, class: "comment-item__delete", style: "margin-left: auto;" %>
      <% end %>
    </div>
    <p class="comment-item__text"><%= comment.body %></p>
  </div>
</div>
