<% provide(:title, "Log In") %>

<div class="container page-wrap">
  <div class="row">
    <div class="col-md-5 col-md-offset-3 col-sm-8 col-sm-offset-2">
      <div class="text-center mb-lg">
        <h2 class="page-title">Welcome back</h2>
        <p class="page-subtitle">Log in to RSVP, create events, and comment.</p>
      </div>

      <div class="card">
        <%= form_for(:session, url: login_path) do |f| %>
          <div class="form-group">
            <%= f.label :email, "Email address" %>
            <%= f.email_field :email, class: "form-control", placeholder: "you@example.com" %>
          </div>

          <div class="form-group">
            <%= f.label :password %>
            <%= f.password_field :password, class: "form-control" %>
          </div>

          <div class="mt-lg">
            <%= f.submit "Log In", class: "btn btn-primary btn-xl btn-block" %>
          </div>
        <% end %>
      </div>

      <p class="text-center mt-lg text-muted">
        Don't have an account? <%= link_to "Sign up", signup_path %>
      </p>
    </div>
  </div>
</div>
