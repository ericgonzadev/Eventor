<!DOCTYPE html>
<html>
<head>

  <%= favicon_link_tag 'favicon.ico' %>

  <title>Eventor | <%= yield(:title) %></title>

  <!-- Meta Tags -->
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Eventor — discover, create, and attend events">
  <%= csrf_meta_tags %>

  <!-- Application Stylesheets -->
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track' => true %>

  <!-- Application Javascript -->
  <%= javascript_include_tag 'application' %>

  <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

  <!-- Google Maps API -->
  <script src="//maps.google.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&libraries=places"></script>
  <script src="//cdn.rawgit.com/mahnunchik/markerclustererplus/master/dist/markerclusterer.min.js"></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href='https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800' rel='stylesheet' type='text/css'>
  <link href='https://fonts.googleapis.com/css?family=Merriweather:400,300,300italic,400italic,700,700italic,900,900italic' rel='stylesheet' type='text/css'>

  <%= yield :head %>
</head>
<body>
  <!-- Nav-Bar -->
  <nav id="mainNav" class="navbar navbar-default navbar-fixed-top">
    <div class="container-fluid">
      <div class="navbar-header">
        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
          <span class="sr-only">Toggle navigation</span> Menu <i class="fa fa-bars"></i>
        </button>
        <%= link_to "Eventor", root_path, class: "navbar-brand page-scroll" %>
      </div>
      <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
        <ul class="nav navbar-nav navbar-right">
          <li><%= link_to "Home", root_path %></li>
          <li><%= link_to "Events", events_path %></li>
          <% if current_user %>
            <li><%= link_to "Create Event", create_event_path %></li>
            <li><%= link_to "Profile", current_user %></li>
            <li><%= link_to "Logout", logout_path, method: "delete" %></li>
          <% else %>
            <li><%= link_to "Sign Up", signup_path %></li>
            <li><%= link_to "Login", login_path %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>

  <%= render "shared/flash_messages" %>

  <%= yield %>

  <!-- Footer -->
  <div class="container">
    <hr class="soft">
    <footer>
      <div class="row">
        <div class="col-sm-6">
          <div id="copyright">
            © <%= Time.now.year %> Eventor · built by <a href="http://www.eric-gonzalez.com/" target="_blank" rel="noopener">Eric Gonzalez</a>
          </div>
        </div>
        <div class="col-sm-6 text-right">
          <ul id="social-links">
            <li><a href="https://www.facebook.com/EventorWeb/" target="_blank" rel="noopener"><i class="fa fa-facebook"></i> Facebook</a></li>
            <li><a href="https://github.com/Twinpair/Eventor" target="_blank" rel="noopener"><i class="fa fa-github"></i> Source</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </div>

  <%= debug(params) if Rails.env.development? %>
</body>
</html>
